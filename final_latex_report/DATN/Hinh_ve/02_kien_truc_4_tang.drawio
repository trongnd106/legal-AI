        <mxCell id="app" value="TẦNG 4 — APPLICATION LAYER&#xa;&#xa;• Frontend Next.js (Chat UI, Upload HĐLĐ)&#xa;• FastAPI Backend (/api/chat, /api/contract/analyze)&#xa;• Trả về: answer + article_citations + temporal_warnings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontStyle=0" vertex="1" parent="1">
