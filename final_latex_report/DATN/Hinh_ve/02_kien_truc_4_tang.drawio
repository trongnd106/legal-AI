        <mxCell id="query" value="TẦNG 3 — QUERY LAYER&#xa;&#xa;• Local Search / Global Search / Basic Search&#xa;• VNLegalReasoningEngine (multi-hop)&#xa;• Temporal Filter • Rule Validator • Citation Resolver" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;" vertex="1" parent="1">
